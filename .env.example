# Copy these campaign settings into a private local .env. Do not commit credentials.
PRICE_DROP_MAX_MESSAGES_PER_RUN=20
PRICE_DROP_MIN_DELAY_SECONDS=300
PRICE_DROP_MAX_DELAY_SECONDS=600
PRICE_DROP_TIMEZONE=America/Santiago
PRICE_DROP_START_TIME=09:00
PRICE_DROP_END_TIME=19:00
PRICE_DROP_ALLOWED_WEEKDAYS=MON,TUE,WED,THU,FRI
PRICE_DROP_DRY_RUN_DEFAULT=true
PRICE_DROP_WASENDER_PLAN=trial
PRICE_DROP_DAILY_PROVIDER_CAP=50
PRICE_DROP_WHATSAPP_CHANNEL_MODE=wasenderapi

# Only controls reply attribution; it does not enable sends. Keep reply context
# active on the service for the campaign's existing response window.
PRICE_DROP_LEADS_V2_CONTEXT_ENABLED=true

# Fail-closed manual-send gates. Keep these disabled on Render and until the
# operator has reviewed approval, the audience, and WhatsApp authorization.
PRICE_DROP_LEADS_V2_SEND_ENABLED=false
PRICE_DROP_LEADS_V2_REAL_PILOT_ENABLED=false
PRICE_DROP_LEADS_V2_REAL_CAMPAIGNS_ENABLED=false
PRICE_DROP_LEADS_V2_WHATSAPP_CONTACT_REVIEWED=false
